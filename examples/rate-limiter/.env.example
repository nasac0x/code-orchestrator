# Rate Limit Settings
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SKIP_PATHS=/health,/ready,/api/metrics,/dashboard

# Redis Backend (Optional - enables multi-instance mode)
# Uncomment and configure to use Redis instead of in-memory storage
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=myapp
# REDIS_MAX_RETRIES=3
# REDIS_RETRY_DELAY=100

# Metrics & Dashboard
METRICS_ENABLED=true
METRICS_TTL_HOURS=24
METRICS_TOP_IPS_LIMIT=10
METRICS_LATENCY_SAMPLES=1000

# Redis Resilience
FAIL_OPEN=false
COMMAND_TIMEOUT_MS=200
MAX_RETRIES_PER_REQUEST=1
REDIS_LAZY_CONNECT=true

# Auth Tokens (Optional - enables Bearer token auth)
# METRICS_AUTH_TOKEN=your-secret-token-here
# DASHBOARD_AUTH_TOKEN=your-secret-token-here